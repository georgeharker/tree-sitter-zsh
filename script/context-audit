#!/usr/bin/env bash
# Audit the external scanner's context stack over zsh files.
#
#   script/context-audit FILE...          one line per file
#   script/context-audit --summary FILE...  totals only
#
# Builds src/ with -DZSH_SCANNER_AUDIT (normal builds are unaffected),
# linked against tree-sitter's single-file library (lib/src/lib.c) because
# the harness reads the final tree's scanner state, which is internal.
# The tree-sitter sources are taken from $TREE_SITTER_SRC if set, else
# shallow-cloned once (at the version that generated src/parser.c) into
# .cache/ (gitignored; .clangd points there for editor support).
# A complete file should end with depth=0; anything left on the stack is a
# leaked context that later scanner decisions may silently depend on.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
ts_version=v0.26.8
ts=${TREE_SITTER_SRC:-$root/.cache/tree-sitter-$ts_version}
if [ ! -f "$ts/lib/src/lib.c" ]; then
  mkdir -p "$(dirname "$ts")"
  git clone -q --depth 1 --branch "$ts_version" \
    https://github.com/tree-sitter/tree-sitter "$ts" 2>/dev/null
fi
bin=$(mktemp -d)/context-audit
cc -O2 -DZSH_SCANNER_AUDIT -I"$ts/lib/include" -I"$ts/lib/include/tree_sitter" \
  -I"$ts/lib/src" -I"$root/src" -o "$bin" \
  "$root/script/context-audit.c" "$root/src/parser.c" "$root/src/scanner.c" \
  "$ts/lib/src/lib.c"
summary=0
if [ "${1:-}" = --summary ]; then summary=1; shift; fi
# One line per file: FILE<TAB>AUDIT depth=N stack=... mismatch=... underflow=... errors=N
out=$("$bin" "$@" 2>&1 | sed -E 's/\tAUDIT /\t/')
if [ $summary = 1 ]; then
  printf '%s\n' "$out" | awk '{
      e = $0; sub(/.*errors=/, "", e); d = $0; sub(/.*depth=/, "", d); sub(/ .*/, "", d)
      files++; errs += e; if (e == 0) clean++; if (d > 0) { leaky++; open += d }
    } END { printf "files=%d clean=%d errors=%d leaky=%d open-contexts=%d\n", files, clean, errs, leaky, open }'
else
  printf '%s\n' "$out"
fi
